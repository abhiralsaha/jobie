# ---- master switches ---------------------------------------------------------
AI_PIPELINE_ENABLED=false          # true = fresh_watcher hands new jobs to the AI pipeline
AI_DRY_RUN=true                    # true = Telegram + e-mail are RECORDED, never sent. Flip to false when ready.
AI_RUN_APPROVAL_POLLER=true        # run in exactly ONE process (getUpdates allows one consumer per bot)

# ---- AI (reuse the key you already have; nothing else needed) ---------------
# Either keep your existing variable (ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY /
# GROQ_API_KEY / OPENROUTER_API_KEY) and it is auto-detected, or set explicitly:
# AI_PROVIDER=anthropic            # anthropic | openai | gemini | groq | openrouter | openai_compat
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=                     # only for openai_compat
AI_MAX_RPM=20

# ---- classification policy (default: range must fit inside 0-2 years) -------
AI_MAX_REQUIRED_MIN_YEARS=2
AI_MAX_REQUIRED_MAX_YEARS=2

# ---- persistence --------------------------------------------------------------
# Postgres (recommended on Render, survives restarts). Falls back to SQLite when unset.
# AI_DATABASE_URL=postgresql://...  (or reuse DATABASE_URL / SUPABASE_DB_URL)
AI_SQLITE_PATH=data/ai_pipeline.sqlite3

# ---- Telegram -----------------------------------------------------------------
# Variable NAMES referenced from config/telegram_destinations.json go here, e.g.:
# TG_TOKEN_ONE_MIN=   TG_CHAT_ONE_MIN=   ... TG_TOKEN_CONTROL=   TG_CHAT_CONTROL=
AI_TELEGRAM_AUTHORIZED_USER_ID=      # YOUR numeric Telegram user id; only this id can Approve

# ---- e-mail (your own account; use an app password) ---------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl                  # ssl | starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# ---- referral contact discovery (all optional; without them contacts stay empty) ----
CONTACT_SEARCH_PROVIDER=none       # brave | google_cse | serpapi | none
BRAVE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=
HUNTER_API_KEY=
CONTACT_LOCATION_HINT=             # e.g. India
SEARCH_DAILY_CAP=90
HUNTER_DAILY_CAP=20
REFERRAL_DAILY_JOB_CAP=15
SENDABLE_EMAIL_STATUSES=verified_service,public_evidence
