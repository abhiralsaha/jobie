[Unit]
Description=LinkedIn Job Agent
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/linkedin-job-agent
EnvironmentFile=/opt/linkedin-job-agent/.env
ExecStart=/opt/linkedin-job-agent/venv/bin/python run.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
