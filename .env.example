# Supabase pooled PostgreSQL connection string (required)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# API authentication (generate a random value of at least 32 characters)
JOBIE_API_TOKEN=replace-with-a-long-random-token

# Main outbound Telegram bot
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_CHAT_ID=replace-with-private-chat-id

# Separate ultra-fresh watcher bot; leave both empty to use the main bot
FRESH_WATCHER_BOT_TOKEN=
FRESH_WATCHER_CHAT_ID=
FRESH_WATCHER_INTERVAL=60
FRESH_WATCHER_LOOKBACK=120

# LinkedIn public guest search
LINKEDIN_SEARCH_KEYWORDS=software engineer
LINKEDIN_SEARCH_LOCATION=Gurugram, Haryana, India
LINKEDIN_POLL_INTERVAL_SECONDS=600
LINKEDIN_LOOKBACK_HOURS=24
LINKEDIN_MAX_SEARCH_PAGES=2
RECENT_JOB_WINDOW_SECONDS=180

# Scheduled and manual digests
DAILY_DIGEST_TIME=18:00
DAILY_DIGEST_TIMEZONE=Asia/Kolkata
MANUAL_DIGEST_MAX_PER_DAY=3
MANUAL_DIGEST_COOLDOWN_SECONDS=300

# Optional rolling digest bots (set complete token/chat pairs to enable)
TELEGRAM_DIGEST_BOT_TOKEN=
TELEGRAM_DIGEST_CHAT_ID=
TELEGRAM_DIGEST_INTERVAL_HOURS=10
TELEGRAM_DIGEST_5M_BOT_TOKEN=
TELEGRAM_DIGEST_5M_CHAT_ID=
TELEGRAM_DIGEST_15M_BOT_TOKEN=
TELEGRAM_DIGEST_15M_CHAT_ID=
TELEGRAM_DIGEST_30M_BOT_TOKEN=
TELEGRAM_DIGEST_30M_CHAT_ID=
TELEGRAM_DIGEST_1H_BOT_TOKEN=
TELEGRAM_DIGEST_1H_CHAT_ID=

# Optional authorized JSON feed connector
AUTHORIZED_JOB_FEED_URL=
AUTHORIZED_JOB_FEED_TOKEN=
JOBIE_API_URL=http://127.0.0.1:8001/jobs/import
FEED_POLL_SECONDS=120

# Optional paths and request proxy
SUPABASE_URL=
PROFILE_PATH=
LOG_PATH=
LINKEDIN_PROXY_URL=
