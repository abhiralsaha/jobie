# Supabase pooled PostgreSQL connection string (required)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# API authentication (generate a random value of at least 32 characters)
JOBIE_API_TOKEN=replace-with-a-long-random-token

# Main outbound Telegram bot
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_CHAT_ID=replace-with-private-chat-id

# Separate ultra-fresh watcher bot; leave both empty to use the main bot
FRESH_WATCHER_BOT_TOKEN=
FRESH_WATCHER_CHAT_ID=
FRESH_WATCHER_INTERVAL=60
FRESH_WATCHER_LOOKBACK=120

# LinkedIn public guest search
LINKEDIN_SEARCH_KEYWORDS=software engineer
LINKEDIN_SEARCH_LOCATION=Gurugram, Haryana, India
LINKEDIN_POLL_INTERVAL_SECONDS=600
LINKEDIN_LOOKBACK_HOURS=24
LINKEDIN_MAX_SEARCH_PAGES=2
RECENT_JOB_WINDOW_SECONDS=180

# Scheduled and manual digests
DAILY_DIGEST_TIME=18:00
DAILY_DIGEST_TIMEZONE=Asia/Kolkata
MANUAL_DIGEST_MAX_PER_DAY=3
MANUAL_DIGEST_COOLDOWN_SECONDS=300

# Optional rolling digest bots (set complete token/chat pairs to enable)
TELEGRAM_DIGEST_BOT_TOKEN=
TELEGRAM_DIGEST_CHAT_ID=
TELEGRAM_DIGEST_INTERVAL_HOURS=10
TELEGRAM_DIGEST_5M_BOT_TOKEN=
TELEGRAM_DIGEST_5M_CHAT_ID=
TELEGRAM_DIGEST_15M_BOT_TOKEN=
TELEGRAM_DIGEST_15M_CHAT_ID=
TELEGRAM_DIGEST_30M_BOT_TOKEN=
TELEGRAM_DIGEST_30M_CHAT_ID=
TELEGRAM_DIGEST_1H_BOT_TOKEN=
TELEGRAM_DIGEST_1H_CHAT_ID=

# Optional authorized JSON feed connector
AUTHORIZED_JOB_FEED_URL=
AUTHORIZED_JOB_FEED_TOKEN=
JOBIE_API_URL=http://127.0.0.1:8001/jobs/import
FEED_POLL_SECONDS=120

# Optional paths and request proxy
SUPABASE_URL=
PROFILE_PATH=
LOG_PATH=
LINKEDIN_PROXY_URL=

# Optional AI job pipeline. Keep dry-run enabled until its routing and output
# have been reviewed. The watcher is the only process that should run approvals.
AI_PIPELINE_ENABLED=false
AI_DRY_RUN=true
AI_RUN_APPROVAL_POLLER=true
AI_TELEGRAM_AUTHORIZED_USER_ID=
# Reuse an existing provider key above/in Render, or set all three explicitly:
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=                         # only for AI_PROVIDER=openai_compat
AI_MAX_RPM=20
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=4
AI_MIN_DESC_CHARS=250
AI_MAX_JOB_ATTEMPTS=8
AI_WORKER_THREADS=4
AI_MAX_REQUIRED_MIN_YEARS=2
AI_MAX_REQUIRED_MAX_YEARS=2
AI_APPROVAL_EXPIRE_DAYS=3
AI_DESTINATIONS_FILE=config/telegram_destinations.json
AI_RESUME_PROFILE_FILE=config/resume_profile.json
AI_RESUME_TEMPLATE_FILE=templates/resume_template.tex
AI_REFERRAL_TEMPLATE_FILE=config/referral_template.txt
AI_COMPANY_DOMAINS_FILE=config/company_domains.json
AI_RESUMES_DIR=resumes
AI_RESUME_MAX_PAGES=1
AI_RESUME_MAX_PROJECTS=3
AI_RESUME_COMPILE_TIMEOUT=60
# Reuses SUPABASE_DB_URL by default; optionally set AI_DATABASE_URL explicitly.
# AI_DATABASE_URL=
AI_SQLITE_PATH=data/ai_pipeline.sqlite3

# The existing watcher bot is reserved for 1-minute job alerts. The new AI
# bot token will be reused for the addon channels/control bot; fill these when
# that bot and its chats are created. Destination JSON stores names only.
AI_TELEGRAM_BOT_TOKEN=
AI_TELEGRAM_FRESHER_CHAT_ID=
AI_TELEGRAM_5_30_CHAT_ID=
AI_TELEGRAM_CONTROL_CHAT_ID=

# Optional e-mail approvals; never sent while AI_DRY_RUN=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# Optional contact lookup; contacts remain empty when these are not configured.
CONTACT_SEARCH_PROVIDER=none
BRAVE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=
HUNTER_API_KEY=
CONTACT_LOCATION_HINT=
SEARCH_DAILY_CAP=90
HUNTER_DAILY_CAP=20
REFERRAL_DAILY_JOB_CAP=15
SENDABLE_EMAIL_STATUSES=verified_service,public_evidence
